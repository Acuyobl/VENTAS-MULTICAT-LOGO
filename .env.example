# ── Infraestructura local (docker compose) ─────────────────────────────
# Puerto del host para Postgres. Si 5432 está ocupado en tu máquina, cámbialo aquí
# y en DATABASE_URL (en este equipo de desarrollo se usa 55432).
POSTGRES_PORT=5432
POSTGRES_USER=vc
POSTGRES_PASSWORD=vc_dev_password
POSTGRES_DB=ventascatalogo
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── API ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
STAFF_PUBLIC_URL=http://app.localhost:3000
TIENDA_PUBLIC_URL=http://tienda.localhost:3000
CORS_ORIGINS=http://localhost:3000,http://app.localhost:3000,http://tienda.localhost:3000
DATABASE_URL=postgresql://vc:vc_dev_password@localhost:5432/ventascatalogo?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=CAMBIA_ESTO_openssl_rand_base64_48
JWT_REFRESH_SECRET=CAMBIA_ESTO_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_STAFF_AUDIENCE=staff
AUTH_CUSTOMER_AUDIENCE=customer
STAFF_REFRESH_TTL=7d
CUSTOMER_REFRESH_TTL=30d
MAGIC_LINK_TTL=20m
MFA_ISSUER=VentasCatálogo
AUTH_COOKIE_DOMAIN=
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
MFA_ENFORCE_ADMINS=true
# Helper SOLO de desarrollo: expone POST /auth/dev/totp para autocompletar el TOTP
# del login staff. Prohibido en producción (el arranque aborta si NODE_ENV=production).
DEV_AUTH_HELPERS=false
ENCRYPTION_KEY=CAMBIA_ESTO_openssl_rand_base64_32
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── Almacenamiento (MinIO) ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PRODUCTS=vc-products
MINIO_BUCKET_DOCS=vc-docs
MINIO_BUCKET_PUBLIC=vc-public
MINIO_PRESIGN_TTL=900

# ── Google Drive (F1) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly,openid,email,profile

# ── IA (F3) ────────────────────────────────────────────────────────────
# mock es determinista y solo para desarrollo/demo (la API aborta en produccion).
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_DEFAULT=deepseek-chat
AI_MODEL_REASONER=deepseek-reasoner
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=3
AI_MAX_OUTPUT_TOKENS=1200
AI_MONTHLY_QUOTA_TOKENS=2000000
AI_USD_PER_1K_INPUT=0.00027
AI_USD_PER_1K_OUTPUT=0.0011
AI_CACHE_TTL_SECONDS=86400

# Imagenes de contenido: mock genera un SVG local determinista (solo dev); openai usa la API de imagenes.
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Pagos (F2) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYMENTS_RETURN_URL=http://localhost:3000/pago/gracias
# Pasarela por defecto: sandbox (dev) o stripe. En produccion sandbox queda bloqueada.
PAYMENTS_DEFAULT_PROVIDER=sandbox
PAYMENTS_SANDBOX_ENABLED=false
PAYMENTS_LINK_TTL_MINUTES=60

# ── WhatsApp (F3) ──────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=cambia-este-token
# Organizacion destino del WhatsApp entrante (webhook publico).
WHATSAPP_ORG_SLUG=demo
WHATSAPP_APP_SECRET=

# ── Email ──────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VentasCatálogo <no-reply@ventascatalogo.local>
RESEND_API_KEY=

# ── Observabilidad ─────────────────────────────────────────────────────
SENTRY_DSN_API=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1