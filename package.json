{
  "name": "ventascatalogo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ventascatalogo/api --filter @ventascatalogo/web dev",
    "dev:api": "pnpm --filter @ventascatalogo/api dev",
    "dev:web": "pnpm --filter @ventascatalogo/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @ventascatalogo/api prisma:generate",
    "db:migrate": "pnpm --filter @ventascatalogo/api prisma:migrate",
    "db:deploy": "pnpm --filter @ventascatalogo/api prisma:deploy",
    "db:seed": "pnpm --filter @ventascatalogo/api prisma:seed",
    "db:studio": "pnpm --filter @ventascatalogo/api prisma:studio",
    "infra:up": "docker compose up -d",
    "infra:ps": "docker compose ps",
    "infra:logs": "docker compose logs -f --tail=100",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "husky",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
